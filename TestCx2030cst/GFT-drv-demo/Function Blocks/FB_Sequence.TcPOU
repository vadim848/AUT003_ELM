<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Sequence" Id="{b8e869a1-3433-4b63-ae33-13616e01fca5}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Sequence
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	UP_Pause_ton: TON;
	tonReset_Long: TON;
	tonGripper_Open_error: TON;
	tonGropper_Close_Error: TON;
	tonEnable_Motor : TON;
	tonDesable_Motor : TON; 
	tonOneSensorError : TON;
	tonHomingError : TON;
	tonHomingStepDelay : TON;
	tonUserDelay : TON;
	tonMotionError : TON;
	tonLogTimer : TON;
		
	Always_ON :BOOL;
	Delay : BOOL;
	i , a , count: INT;
	Motor_curr_sum : REAL;
	
	buffer_size: INT:=5000;


	
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[Always_ON := TRUE;
Delay := FALSE;


IF NOT gvl_IO.FirstScan 
	THEN
	gvl_io.qxActuator_1 := FALSE;
	gvl_IO.qxActuator_2 := FALSE;	
	gvl_io.Position_PV_Diff := 0 ;
	gvl_io.Position_sp_test := servoctrl.Position;	
	gvl_IO.FirstScan := TRUE;
END_IF


// Emergancy Stop 
IF NOT gvl_io.ixEmergancy_Stop
	THEN
	gvl_io.qxActuator_1 := FALSE;
	gvl_IO.qxActuator_2 := FALSE;
	gvl_io.Gripper_Close_cmd := FALSE;
	gvl_IO.Gripper_Open_cmd := FALSE;
	gvl_io.Gripper_step := 0;
	gvl_io.tonHomingStepDelay_IN := FALSE;
	gvl_io.tonHomingError_IN := FALSE;
	gvl_io.Step := 0;
	gvl_io.Homing_cmd := FALSE;
	gvl_io.Position_sp_test := servoctrl.Position;	
	gvl_io.tonHomingError_IN := FALSE;
	
END_IF


// Password

tonUserDelay(IN:= gvl_io.Password_IN = gvl_io.Password, PT:= T#5M , Q=> , ET=> );

IF tonUserDelay.Q 
	THEN
	gvl_io.Password_IN := 0;
END_IF


//********* Calculation MOTOR PARAMETRS***** 
(*
gvl_io.Position_PV := servoctrl.Position / (46603  *124  );
gvl_io.vcc_SP := gvl_io.Speed_SP * (46603  * 124 );

*)

gvl_io.Position_PV := servoctrl.Position / (46603  *124  );


IF GVL_IO.Step >= 0 
	AND GVL_IO.Step  < 700
	THEN
	gvl_io.vcc_SP := gvl_io.Speed_SP * (46603  * 124 );
	
	ELSIF
		 GVL_IO.Step  > 1000		 
		 THEN
		 gvl_io.vcc_SP := gvl_io.Speed_SP_slow * (46603  * 124 );
END_IF

gvl_io.Motor_I_PV := (DINT_TO_REAL(servoctrl.ActualCurrent) / 100 ) *2;
IF gvl_io.Motor_I_PV < 0 
	THEN gvl_io.Motor_I_PV := gvl_io.Motor_I_PV * (-1);
END_IF


// Change Accseleration bitwin Posoions
IF gvl_io.Homing_OK AND GVL_IO.Step> 1000 
	THEN
	gvl_io.acc_SP := gvl_io.Accseleration_SP_slow * (46603  * 124 );
	ELSIF gvl_io.Homing_OK AND GVL_IO.Step < 1000
		THEN			
			IF gvl_io.Position_PV_HMI > gvl_io.Position_UP_A_SP
				THEN
				gvl_io.acc_SP := gvl_io.Accseleration_A_SP * (46603 *124);
			ELSIF 
				gvl_io.Position_PV_HMI < gvl_io.Position_DN_A_SP
				THEN
				gvl_io.acc_SP := gvl_io.Accseleration_A_SP * (46603 *124);
			ELSE
				gvl_io.acc_SP := gvl_io.Accseleration_SP * (46603 *124);	
			END_IF
		
END_IF



IF servoctrl.ActualCurrent < 0 THEN 
	servoctrl.ActualCurrent := servoctrl.ActualCurrent * (-1) ;
END_IF

// MAnual command Go from HMI -  calculation Parametrs 
IF gvl_io.Homing_OK AND gvl_io.GO_TO_cmd THEN
	gvl_io.Position_sp_test := (gvl_io.Position_SP * 46603  *124) +  (gvl_io.Position_PV_Diff);
END_IF

// Positon_PV_HMI
gvl_io.Position_PV_HMI := (servoctrl.Position - gvl_io.Position_PV_Diff )/ (46603  *124  ) ;



IF GVL_IO.ixEmergancy_Stop AND GVL_IO.Enable
	AND NOT GVL_IO.Emergancy_Error
	THEN
	GVL_IO.Emergancy_OK := TRUE;
	ELSIF NOT GVL_IO.ixEmergancy_Stop
		THEN
		GVL_IO.Emergancy_OK := FALSE;	
		gvl_io.Enable_motor_cmd := FALSE;		
END_IF
//Emergancy Error
IF NOT GVL_IO.ixEmergancy_Stop 
	THEN 
	GVL_IO.Emergancy_Error := TRUE;	
END_IF

//Enable STO to Drive motor
GVL_IO.qxSTO_toDrive := Gvl_io.Enable;


// Ton TIMERS 
tonEnable_Motor(IN:= gvl_io.Enable_motor_cmd, PT:=T#500MS , Q=> , ET=> );
tonDesable_Motor(IN:= NOT gvl_io.Enable_motor_cmd, PT:=T#500MS , Q=> , ET=> );

// ******  Desable MOTOR *****
// close Breaks
IF NOT gvl_io.Enable_motor_cmd
	THEN gvl_io.qxBrakeOpen := FALSE;
END_IF
// desable  motor
IF NOT gvl_io.Enable_motor_cmd 
	AND tonDesable_Motor.Q	
	THEN
	gvl_io.Enable := FALSE;
END_IF


// Motor not ENABLE 
IF NOT gvl_io.Enable
	THEN 
	gvl_io.Position_sp_test := servoctrl.Position;
END_IF


// ****** MOTOR Limits *****
IF gvl_io.Position_PV_HMI >= gvl_io.Motor_Limit_UP
	OR gvl_io.Position_PV_HMI <= gvl_io.Motor_Limit_DN
	THEN
	gvl_io.Enable := FALSE;
END_IF


	
// ****** UP position Limits ****
IF gvl_io.Position_UP_SP >= gvl_io.Motor_Limit_UP - 1 
	THEN
	gvl_io.Position_UP_SP := gvl_io.Motor_Limit_UP - 1;	

ELSIF gvl_io.Position_UP_SP <= gvl_io.Motor_Limit_DN + 1 
	THEN 
	gvl_io.Position_UP_SP := gvl_io.Motor_Limit_DN + 1;		
END_IF


// ****** DN position Limits ****
IF gvl_io.Position_DN_SP <= gvl_io.Motor_Limit_DN + 1 
	THEN
	gvl_io.Position_DN_SP := gvl_io.Motor_Limit_DN + 1;	
ELSIF 	gvl_io.Position_DN_SP >= gvl_io.Motor_Limit_UP - 1 
	THEN
	gvl_io.Position_DN_SP := gvl_io.Motor_Limit_UP - 1;
END_IF




// ****** Enable MOTOR ***** 
//enable motor
IF gvl_io.Enable_motor_cmd
	THEN
	gvl_io.Enable := TRUE;
END_IF

IF gvl_io.Enable_motor_cmd
	AND tonEnable_Motor.Q
	THEN
	gvl_io.qxBrakeOpen := TRUE;
END_IF


// Error global
GVL_IO.Error := GVL_IO.Gripper_Open_Error 
				OR GVL_IO.Gripper_Close_Error 
				OR gvl_io.SensorLock_Error 
				OR gvl_io.Homing_Error 
				OR gvl_io.Motor_Error;

(*// TON MOTION ERROR 
tonMotionError(IN:= gvl_io.Homing_OK AND gvl_io.Step <> 0 AND gvl_io.tonMotionError_IN , PT:= T#5S , Q=> , ET=> );

gvl_io.tonMotionError_IN := servoCtrl.Position > (servoCtrl.PosTarget + 100)
							OR servoCtrl.Position < (servoCtrl.PosTarget - 100);

IF 
(servoCtrl.Position - gvl_io.pp > 32000
OR servoCtrl.Position - gvl_io.pp < 32000)
THEN

*)


// ********* Motor Error ******  ERROR POSITION ****

IF gvl_io.Homing_OK 
AND ( servoCtrl.StatusWord.3 
	OR  ABS(servoCtrl.Position - REAL_TO_DINT(gvl_io.pp)) > 23100000)
		THEN
	gvl_io.Motor_Error := TRUE;
	gvl_io.Enable_motor_cmd := FALSE;
	
END_IF
	
 
//Reset Errors
IF GVL_IO.Reset 
	THEN
	GVL_IO.Gripper_Open_Error := FALSE;
	GVL_IO.Gripper_Close_Error := FALSE;
	GVL_IO.Emergancy_Error := FALSE;
	gvl_io.SensorLock_Error := FALSE;
	gvl_io.Homing_Error := FALSE;
	gvl_io.Motor_Error := FALSE;
	gvl_io.Log_CloseFile_cmd := FALSE;	
END_IF

//TON Reset Long 
tonReset_Long(IN:= GVL_IO.Reset, PT:= T#5S, Q=> , ET=> );
IF tonReset_Long.Q
	THEN
	GVL_IO.Step := 0; 
	GVL_IO.UP_pause_in := FALSE;
	GVL_IO.qxClose_Gripper := FALSE;
	GVL_IO.qxOpen_Gripper := FALSE;
	GVL_IO.GO_TO_cmd := FALSE;	
	gvl_io.tonHomingError_IN := FALSE;
	gvl_io.Log_CloseFile_cmd := FALSE;
	
END_IF


// TON UP Pause 
UP_Pause_ton(IN:= GVL_IO.UP_pause_in, PT:= T#1S, Q=> , ET=> );

gvl_io.TwoSensorLock := gvl_io.ixGripperLock_1 AND gvl_io.ixGripperLock_2;


// TON Homing Error
tonHomingError(IN:= gvl_io.tonHomingError_IN, PT:= T#60S , Q=> , ET=> );
IF tonHomingError.Q
	THEN
	gvl_io.Position_sp_test := servoctrl.Position;
	gvl_io.Step := 0 ;
	gvl_io.Homing_cmd := FALSE;
	gvl_io.Enable_motor_cmd := FALSE;
	gvl_io.Homing_Error := TRUE;
	gvl_io.tonHomingError_IN := FALSE;	 
END_IF

// TON HOMING STEP DELAY 
tonHomingStepDelay(IN:= gvl_io.tonHomingStepDelay_IN , PT:= gvl_io.tonHomingStepDelay_SP, Q=> , ET=> );



//	STOP PB from HMI
IF (gvl_io.Stop 
	OR GVL_IO.Error)
	AND GVL_IO.Step <> 0 
	THEN
	gvl_io.Position_sp_test := servoctrl.Position;
	GVL_IO.Step := 0;
	GVL_IO.Start := FALSE;
END_IF


// Ready for Start
GVL_IO.Ready_for_start := GVL_IO.Emergancy_OK 
						AND GVL_IO.Homing_OK 
						
						//AND GVL_IO.ixHome_Position 
						AND NOT GVL_IO.Error;


// Sequence
act_Main_State();

///// ******* Posotion SP Limit *******
IF gvl_io.Position_SP  >= gvl_io.Motor_Limit_UP - 1 
	THEN
	gvl_io.Position_SP := gvl_io.Motor_Limit_UP - 1; 
	ELSIF 
		gvl_io.Position_SP <= gvl_io.Motor_Limit_DN + 1 
	THEN 
	gvl_io.Position_SP := gvl_io.Motor_Limit_DN + 1;
END_IF



// 		******** GRIPPER *************

// One Sensor lock not work 
tonOneSensorError(IN:= gvl_io.Gripper_step >0 AND ((gvl_io.ixGripperLock_1 AND NOT gvl_io.ixGripperLock_2) OR (NOT  gvl_io.ixGripperLock_1 AND gvl_io.ixGripperLock_2)) , PT:= T#2S , Q=> , ET=> );
IF tonOneSensorError.Q
	THEN
	gvl_io.SensorLock_Error := TRUE;
END_IF

//TON Gripper Open Error
tonGripper_Open_error(IN:= GVL_IO.Gripper_Open_cmd OR (gvl_io.Gripper_step >0 AND gvl_io.Gripper_step <=130), PT:= T#2S, Q=> , ET=> );
IF tonGripper_Open_error.Q
	THEN
		GVL_IO.Gripper_Open_Error := TRUE;
		GVL_IO.qxActuator_1 := FALSE;
		GVL_IO.qxActuator_2 := FALSE;
		GVL_IO.Gripper_Open_cmd  := FALSE;
		gvl_io.test_Gripper_open_OK := FALSE;
		gvl_io.Gripper_step := 0;
		gvl_io.Step := 0;
END_IF


//TON Gripper Close Error
tonGropper_Close_Error(IN:= GVL_IO.Gripper_Close_cmd OR (gvl_io.Gripper_step >=200 AND gvl_io.Gripper_step <=230) , PT:= T#2S , Q=> , ET=> );
IF tonGropper_Close_Error.Q
	THEN
		GVL_IO.Gripper_Close_Error := TRUE;
		GVL_IO.qxActuator_1 := FALSE;
		GVL_IO.qxActuator_2 := FALSE;
		GVL_IO.Gripper_Close_cmd  := FALSE;
		gvl_io.test_Gripper_close_OK := TRUE;
		gvl_io.Gripper_step := 0;
		gvl_io.Step := 0;		
END_IF

act_Gripper_State();


//**************** LOG **************
tonLogTimer(IN:= gvl_io.tonLogTimer_IN AND NOT gvl_io.tonLogTimer_Q, PT:=T#10MS , Q=> gvl_io.tonLogTimer_Q, ET=> );
IF gvl_io.tonLogTimer_Q
	THEN
	gvl_io.Lod_appendLine_cmd := TRUE;
	i := i + 1;	
	IF i < 0 
		OR i > buffer_size
		THEN
		i := 0;
	END_IF
END_IF



IF gvl_io.Step > 200 
	AND gvl_io.Step < 700
	AND GVL_IO.Cycle_PV >= (GVL_IO.Cycle_SP - 1)
	THEN
	gvl_io.tonLogTimer_IN := TRUE;
	ELSE
	gvl_io.tonLogTimer_IN := FALSE;	
END_IF

// 		Find MAX Motor current in last cycle 
IF gvl_io.tonLogTimer_IN
	AND gvl_io.Motor_I_MAX < gvl_io.Motor_I_PV
	THEN
	gvl_io.Motor_I_MAX := gvl_io.Motor_I_PV ;	
END_IF

// 		Calculation Average Motor Current in last cycle 
IF gvl_io.Lod_appendLine_cmd
	THEN
	gvl_io.Motor_I_mem[i] := gvl_io.Motor_I_PV;
	gvl_io.Position_PV_mem[i] := gvl_io.Position_PV_HMI;	
END_IF

IF gvl_io.Calc_log_cmd
	THEN
	count := 0;
	Motor_curr_sum := 0.0;
	FOR a := 1 TO buffer_size DO 	
	
		IF gvl_io.Motor_I_mem[a] > 0
			THEN
			Motor_curr_sum := Motor_curr_sum + gvl_io.Motor_I_mem[a];
			count := count + 1;
			
		END_IF	
	END_FOR
	
	gvl_io.Motor_I_AVR := Motor_curr_sum / INT_TO_REAL(count);	
	gvl_io.Calc_log_cmd := FALSE;
END_IF









































]]></ST>
    </Implementation>
    <Action Name="act_Gripper_State" Id="{8d0a8818-5656-4dbe-b4c2-1c9fdc8c392a}">
      <Implementation>
        <ST><![CDATA[CASE GVL_IO.Gripper_step OF 
	
	0: 	// Wait command 
	IF gvl_io.Gripper_Open_cmd 
		AND NOT GVL_IO.Error
		THEN
			GVL_IO.Gripper_step := 100; // Open Gripper
		ELSIF gvl_io.Gripper_Close_cmd 
			AND NOT GVL_IO.Error
			THEN
			gvl_io.Gripper_step := 200; // Close Gripper
	END_IF
	
	100: 	//check sensor 
	IF gvl_io.ixGripper_Unlock
		THEN
			gvl_io.Gripper_Open_cmd := FALSE;
			gvl_io.Gripper_step := 0;
			gvl_io.Gripper_State_Open  := TRUE;
			gvl_io.Gripper_State_Close := FALSE;
					ELSE
			gvl_io.Gripper_step := 110;
	END_IF
	
	
	110: 	//Open Gripper sequence
	gvl_io.qxActuator_1 := TRUE;
	gvl_io.qxActuator_2 := TRUE;
	gvl_io.Gripper_step := 120;
	gvl_io.Gripper_State_Close := FALSE;
	
	120: 	// wait sensor 
	IF gvl_io.ixGripper_Unlock
		THEN
		gvl_io.qxActuator_1 := FALSE;
		gvl_io.qxActuator_2 := FALSE;
		gvl_io.Gripper_Open_cmd := FALSE;
		gvl_io.Gripper_State_Open := TRUE;
		gvl_io.test_Gripper_open_OK := TRUE;		
		gvl_io.Gripper_step := 0;
	END_IF
	
	
	
	200: 	//check sensor 
	IF gvl_io.ixGripperLock_1 AND gvl_io.ixGripperLock_2
		THEN
			gvl_io.Gripper_Close_cmd := FALSE;
			gvl_io.Gripper_step := 0;
			gvl_io.Gripper_State_Close := TRUE; 
			
		ELSE
			gvl_io.Gripper_step := 210;
	END_IF
	
	
	210: 	//Close Gripper sequence
	gvl_io.qxActuator_1 := FALSE;
	gvl_io.qxActuator_2 := TRUE;	
	gvl_io.Gripper_step := 220;
	gvl_io.Gripper_State_Open := FALSE;

	
	220: 	// wait sensor 
	IF gvl_io.ixGripperLock_1 AND gvl_io.ixGripperLock_2
		THEN
		gvl_io.qxActuator_1 := FALSE;
		gvl_io.qxActuator_2 := FALSE;
		gvl_io.Gripper_Close_cmd := FALSE;
		gvl_io.Gripper_State_Close := TRUE;
		gvl_io.test_Gripper_close_OK := TRUE;
		gvl_io.Gripper_step := 0;
	END_IF
	
	
END_CASE]]></ST>
      </Implementation>
    </Action>
    <Action Name="act_Main_State" Id="{55c86d07-dddb-42b4-93df-21c992c4c743}">
      <Implementation>
        <ST><![CDATA[CASE GVL_IO.Step OF 
	
	0: //
	i := 0;
	gvl_io.New_CSV_cmd := FALSE;
	IF GVL_IO.Ready_for_start 
		AND GVL_IO.Position_PV_HMI <> GVL_IO.Position_UP_SP
		AND GVL_IO.Motor_UP 
		THEN		
		GVL_IO.Step := 10;
	ELSIF GVL_IO.Ready_for_start AND GVL_IO.ixHome_Position
		AND GVL_IO.test_Gripper_close_OK
		AND GVL_IO.test_Gripper_open_OK
		AND GVL_IO.test_motor_sldown_ok
		AND GVL_IO.test_motor_slUP_ok
		AND GVL_IO.test_Insert_OK
		AND GVL_IO.test_slowCycle_OK
		AND GVL_IO.ATP_start_cmd AND GVL_RunLog.SN_valid	// no valid SN, no ATP start
		THEN
		gvl_io.Motor_State_Down	:= FALSE;
		gvl_io.Motor_State_Up	:= FALSE;
		GVL_IO.Step := 210;
		GVL_IO.Cycle_PV := 0;
	ELSIF GVL_IO.Ready_for_start AND GVL_IO.ixHome_Position
		AND GVL_IO.test_Gripper_close_OK
		AND GVL_IO.test_Gripper_open_OK
		AND GVL_IO.test_motor_sldown_ok
		AND GVL_IO.test_motor_slUP_ok
		AND GVL_IO.test_Insert_OK
		AND GVL_IO.Slow_cycle_cmd
		THEN 
		GVL_IO.Step := 1210;
		GVL_IO.Cycle_PV := 0;						
	ELSIF GVL_IO.Ready_for_start 
		AND GVL_IO.Position_PV_HMI <> GVL_IO.Position_DN_SP
		AND GVL_IO.Motor_DN
		THEN
		GVL_IO.Step := 110;
	ELSIF GVL_IO.Ready_for_start AND GVL_IO.ixHome_Position
		AND GVL_IO.Cycle_SP > 0
		AND GVL_IO.Start
		THEN
		GVL_IO.Step := 210;
		GVL_IO.Cycle_PV := 0;
	ELSIF GVL_IO.Homing
		AND gvl_io.Emergancy_OK 
		THEN
		GVL_IO.Step := 700;
	ELSIF GVL_IO.Ready_for_start 
		AND GVL_IO.Position_PV_HMI <> GVL_IO.Position_UP_SP
		AND GVL_IO.Motor_UP_slow_cmd
		THEN	
	    gvl_io.Motor_State_Down:= FALSE;
		GVL_IO.Step := 1010;
	ELSIF GVL_IO.Ready_for_start 
		AND GVL_IO.Position_PV_HMI <> GVL_IO.Position_DN_SP
		AND GVL_IO.Motor_DN_slow_cmd
		THEN
		gvl_io.Motor_State_Up:= FALSE;
		GVL_IO.Step := 1110;		
	END_IF

	
	10:		//Motor UP command - write parameters
	gvl_io.Position_sp_test := (GVL_IO.Position_UP_SP * 46603  * 124) + (gvl_io.Position_PV_Diff);
	GVL_IO.Position_UP_SP_HL := (GVL_IO.Position_UP_SP) + 1;
	GVL_IO.Position_UP_SP_LL := (GVL_IO.Position_UP_SP) - 1;
	GVL_IO.Step := 20;
	
	20:		//Motor UP command - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_UP_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_UP_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_UP_SP_HL )
		THEN
		GVL_IO.Step := 0;
	END_IF
	
	110:	//MOtor DN command - write parameters
	gvl_io.Position_sp_test := (GVL_IO.Position_DN_SP * 46603  *124) +  (gvl_io.Position_PV_Diff);
	GVL_IO.Position_DN_SP_HL := (GVL_IO.Position_DN_SP) + 1;
	GVL_IO.Position_DN_SP_LL := (GVL_IO.Position_DN_SP) - 1;
	GVL_IO.Step := 120;
	
	120:	//Motor UP command - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_DN_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_DN_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_DN_SP_HL )
		THEN
		GVL_IO.Step := 0;
	END_IF
	
	210:	//Cycle -  open gripper 
	FOR a := 1 TO 500 DO 
		gvl_io.Position_PV_mem[a] := 0;
		gvl_io.Motor_I_mem[a] := 0.0;
	END_FOR
	gvl_io.Motor_I_MAX := 0.0;
	gvl_io.Motor_I_AVR := 0.0;
	
	GVL_IO.Gripper_Open_cmd := TRUE;
	GVL_IO.Step := 220;
	//gvl_io.New_CSV_cmd := TRUE;
	gvl_io.Log_Data := TRUE;
	gvl_io.Log_nMode := 2;
	
	220:	//Cycle - wait feedback gripper opened
	IF GVL_IO.ixGripper_Unlock
		AND NOT GVL_IO.Gripper_Open_cmd
		THEN 		
		GVL_IO.Step := 230;
		gvl_io.Log_Data := FALSE;
	END_IF
	
	230:	//Cycle - write parameters
	gvl_io.Position_sp_test := (GVL_IO.Position_DN_SP * 46603  *124) +  (gvl_io.Position_PV_Diff);
	GVL_IO.Position_DN_SP_HL := (GVL_IO.Position_DN_SP) + 1;
	GVL_IO.Position_DN_SP_LL := (GVL_IO.Position_DN_SP) - 1;
	GVL_IO.Step := 240;
	
	240:	//Cycle - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_DN_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_DN_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_DN_SP_HL )
		THEN
		gvl_io.Log_Data := TRUE;
		gvl_io.Log_nMode := 4;
		GVL_IO.Step := 260;
	END_IF
	
	
	260:	//Cycle - close gripper
	GVL_IO.Gripper_Close_cmd := TRUE;
	GVL_IO.Step := 270;
	
	270:	//Cycle - wait gripper close
	IF GVL_IO.ixGripperLock_1
		AND GVL_IO.ixGripperLock_2
		AND NOT GVL_IO.Gripper_Close_cmd
		THEN		
		GVL_IO.Step := 280;
	END_IF
	
	
	280:	//Cycle - write parameters 	
	gvl_io.Position_sp_test := (GVL_IO.Position_UP_SP * 46603  *124) + (gvl_io.Position_PV_Diff);
	GVL_IO.Position_UP_SP_HL := (GVL_IO.Position_UP_SP) + 1;
	GVL_IO.Position_UP_SP_LL := (GVL_IO.Position_UP_SP) - 1;
	GVL_IO.Step := 290;
	
	290:	//Cycle - Wait finish UP motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_UP_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_UP_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_UP_SP_HL )
		THEN
		GVL_IO.Step := 310;
	END_IF
	
	310:	//Cycle - Pause 0.5 sec 
	GVL_IO.UP_pause_in := TRUE;
	IF up_pause_ton.Q 
		THEN
		GVL_IO.UP_pause_in := FALSE;
		GVL_IO.Step := 320;
	END_IF
	
	320:	//Cycle - MOtion DN Write parametrs	
	gvl_io.Position_sp_test := (GVL_IO.Position_DN_SP * 46603  *124) + (gvl_io.Position_PV_Diff);
	GVL_IO.Position_DN_SP_HL := (GVL_IO.Position_DN_SP) + 1;
	GVL_IO.Position_DN_SP_LL := (GVL_IO.Position_DN_SP) - 1;
	GVL_IO.Step := 330;
	
	330:	//Motor UP command - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_DN_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_DN_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_DN_SP_HL )
		THEN
		GVL_IO.Step := 350;
	END_IF
	
	350:	//Cycle -  open gripper 
	GVL_IO.Gripper_Open_cmd := TRUE;
	GVL_IO.Step := 360;
	
	360:	//Cycle - wait feedback gripper opened
	IF GVL_IO.ixGripper_Unlock
		AND NOT GVL_IO.Gripper_Open_cmd
		THEN 
		GVL_IO.Cycle_PV := GVL_IO.Cycle_PV + 1;
		GVL_IO.Step := 370;
	END_IF
	
	370:	//Cycle - Check cycle counters 
	IF GVL_IO.Cycle_PV < GVL_IO.Cycle_SP
		THEN
		GVL_IO.Step := 260;
	ELSIF
		GVL_IO.Cycle_PV >= GVL_IO.Cycle_SP
		THEN
		GVL_IO.Step := 400;			
	END_IF
	
	400:	//Cycle - TO Home position 	
	gvl_io.Position_sp_test := (GVL_IO.Position_UP_SP * 46603  *124) + (gvl_io.Position_PV_Diff);
	GVL_IO.Position_UP_SP_HL := (GVL_IO.Position_UP_SP) + 1;
	GVL_IO.Position_UP_SP_LL := (GVL_IO.Position_UP_SP) - 1;
	GVL_IO.Step := 410;
	
	410:	//Cycle - TO Home position - Wait finish UP motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_UP_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_UP_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_UP_SP_HL )
		THEN
		GVL_IO.Step := 430;
	END_IF
	
	430:	//Cycle - TO Home position - close gripper
	GVL_IO.Gripper_Close_cmd := TRUE;
	GVL_IO.Step := 440;
	
	440:	//Cycle - TO Home position - wait gripper close
	IF NOT GVL_IO.Gripper_Close_cmd 
		AND GVL_IO.ixGripperLock_1
		AND GVL_IO.ixGripperLock_2
		THEN
		GVL_IO.Step := 0;
		GVL_IO.Start := FALSE;
		gvl_io.Calc_log_cmd := TRUE;
		gvl_io.Log_CloseFile_cmd := TRUE;
		gvl_io.Lod_appendLine_cmd := FALSE;
		gvl_io.Log_Data:=FALSE;
	END_IF
	
	
	
	
	//***** HOUMING ******
	
	
	700:	//Write online parameters
	gvl_io.tonHomingError_IN := TRUE;
	gvl_io.Step := 710;
	
	710: 	//Check  Homing Sensor
	IF NOT gvl_io.ixHome_Position 
		THEN
		gvl_io.Homing_OK := FALSE;
		gvl_io.Step := 720;
		ELSE
			gvl_io.Step := 740;
			gvl_io.Homing_OK := FALSE;
	END_IF
	
	
	720: 	// Write Homing parametrs
	gvl_io.vcc_SP := 5 * (46603  * 124 );
	gvl_io.acc_SP := 5 * (46603 *124);
	gvl_io.Position_sp_test := (180 * 46603  *124) ;// - gvl_io.Position_PV_Diff - 100;
	gvl_io.Step := 730;
	
	
	730:	// Wait Homing Sensor 
	IF gvl_io.ixHome_Position 
		THEN
		gvl_io.Step := 740;	
	END_IF
	
	740: // Write homing parametrs
	
		gvl_io.Position_PV_Diff := 0 + servoctrl.Position;
		gvl_io.Position_PV_HMI := servoctrl.Position - gvl_io.Position_PV_Diff;
		gvl_io.Position_sp_test := servoctrl.Position;
		gvl_io.Step := 750;
		gvl_io.tonHomingStepDelay_IN := TRUE;
		gvl_io.tonHomingStepDelay_SP := T#3S;
				
	
		
	
	750: 	// Wait Delay , change Homing parametrs
	IF tonHomingStepDelay.Q
		THEN
		gvl_io.tonHomingStepDelay_IN := FALSE;
		gvl_io.vcc_SP := 4 * (46603  * 124 );
		gvl_io.acc_SP := 4 * (46603 *124);

		gvl_io.Position_sp_test := servoctrl.Position - (4 * 46603  *124) ;
		gvl_io.Step := 760;		
	END_IF
	
	
	760:	// wait moving to SP position
	IF servoctrl.Position < gvl_io.Position_sp_test +10
		AND servoctrl.Position > gvl_io.Position_sp_test -10
		THEN
		gvl_io.vcc_SP := 1 * (46603  * 124 );
		gvl_io.acc_SP := 2 * (46603 *124);
		gvl_io.Position_sp_test := gvl_io.Position_PV_Diff + 1000000;
		gvl_io.Step := 770;
	END_IF
	
	770:	// Wait Homing sensor
	IF gvl_io.ixHome_Position 
		THEN
		// Write homing parametrs	
		gvl_io.Position_PV_Diff := 0 + servoctrl.Position;
		gvl_io.Position_sp_test := servoctrl.Position;
		gvl_io.tonHomingStepDelay_IN := TRUE;
		gvl_io.tonHomingStepDelay_SP := T#500MS;
		gvl_io.Step := 780;		
	END_IF
	
	780:	// Wait Dalay 500 ms 
	IF tonHomingStepDelay.Q
		THEN
		gvl_io.tonHomingStepDelay_IN := FALSE; 
		gvl_io.Homing_OK := TRUE;
		gvl_io.Step := 0;	
		gvl_io.tonHomingError_IN := FALSE;
	END_IF
	
	
	
	// TEST SLOW SPEED 
	
	1010:		//Motor UP slow  command - write parameters
	
	
	gvl_io.vcc_SP := gvl_io.Speed_SP_slow * (46603  * 124 );
	gvl_io.acc_SP := gvl_io.Accseleration_SP_slow * (46603 *124);
	gvl_io.Motor_State_Down:= FALSE;
	GVL_IO.Step := 1015;
	Delay := TRUE;
	
	
	1015: 	//write parameters
	IF NOT Delay
		THEN
			gvl_io.Position_sp_test := (GVL_IO.Position_UP_SP * 46603  * 124) + (gvl_io.Position_PV_Diff);
			GVL_IO.Position_UP_SP_HL := (GVL_IO.Position_UP_SP) + 1;
			GVL_IO.Position_UP_SP_LL := (GVL_IO.Position_UP_SP) - 1;
			GVL_IO.Step := 1020;
	END_IF;
	
	1020:		//Motor UP command - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_UP_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_UP_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_UP_SP_HL )
		THEN		
		gvl_io.test_motor_slUP_ok := TRUE;
		gvl_io.Motor_State_Up:= TRUE;
		GVL_IO.Step := 0;
	END_IF
	
	1110:	//MOtor DN command - write parameters
	gvl_io.vcc_SP := gvl_io.Speed_SP_slow * (46603  * 124 );
	gvl_io.acc_SP := gvl_io.Accseleration_SP_slow * (46603 *124);
	gvl_io.Motor_State_Up:= FALSE;
	GVL_IO.Step := 1115;
	Delay := TRUE;
	
	1115: 	//write parameters
	IF NOT Delay
		THEN
	
	gvl_io.Position_sp_test := (GVL_IO.Position_DN_SP * 46603  *124) +  (gvl_io.Position_PV_Diff);
	GVL_IO.Position_DN_SP_HL := (GVL_IO.Position_DN_SP) + 1;
	GVL_IO.Position_DN_SP_LL := (GVL_IO.Position_DN_SP) - 1;
	GVL_IO.Step := 1120;
	END_IF
	
	1120:	//Motor UP command - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_DN_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_DN_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_DN_SP_HL )
		THEN
		//gvl_io.Speed_SP := gvl_io.Speed_SP_mem ;
		//gvl_io.Accseleration_SP := gvl_io.Accseleration_SP_mem ;
		gvl_io.test_motor_sldown_ok := TRUE;
		gvl_io.Motor_State_Down:= TRUE;
		GVL_IO.Step := 0;
	END_IF
	
////  ***************** SLOW CYCLE *****************

	1210:	//Cycle -  open gripper 
		
	
	
	FOR a := 1 TO 500 DO 
		gvl_io.Position_PV_mem[a] := 0;
		gvl_io.Motor_I_mem[a] := 0.0;
	END_FOR
	gvl_io.Motor_I_MAX := 0.0;
	gvl_io.Motor_I_AVR := 0.0;
	
	GVL_IO.Gripper_Open_cmd := TRUE;
	GVL_IO.Step := 1220;
	
	1220:	//Cycle - wait feedback gripper opened
	IF GVL_IO.ixGripper_Unlock
		AND NOT GVL_IO.Gripper_Open_cmd
		THEN 		
		GVL_IO.Step := 1230;
	END_IF
	
	1230:	//Cycle - write parameters
	
	gvl_io.Position_sp_test := (GVL_IO.Position_DN_SP * 46603  *124) +  (gvl_io.Position_PV_Diff);
	GVL_IO.Position_DN_SP_HL := (GVL_IO.Position_DN_SP) + 1;
	GVL_IO.Position_DN_SP_LL := (GVL_IO.Position_DN_SP) - 1;
	GVL_IO.Step := 1240;
	
	1240:	//Cycle - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_DN_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_DN_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_DN_SP_HL )
		THEN
		GVL_IO.Step := 1260;
	END_IF
	
	
	1260:	//Cycle - close gripper
	GVL_IO.Gripper_Close_cmd := TRUE;
	GVL_IO.Step := 1270;
	
	1270:	//Cycle - wait gripper close
	IF GVL_IO.ixGripperLock_1
		AND GVL_IO.ixGripperLock_2
		AND NOT GVL_IO.Gripper_Close_cmd
		THEN		
		GVL_IO.Step := 1280;
	END_IF
	
	
	1280:	//Cycle - write parameters 	
	gvl_io.Position_sp_test := (GVL_IO.Position_UP_SP * 46603  *124) + (gvl_io.Position_PV_Diff);
	GVL_IO.Position_UP_SP_HL := (GVL_IO.Position_UP_SP) + 1;
	GVL_IO.Position_UP_SP_LL := (GVL_IO.Position_UP_SP) - 1;
	GVL_IO.Step := 1290;
	
	1290:	//Cycle - Wait finish UP motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_UP_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_UP_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_UP_SP_HL )
		THEN
		GVL_IO.Step := 1310;
	END_IF
	
	1310:	//Cycle - Pause 0.5 sec 
	GVL_IO.UP_pause_in := TRUE;
	IF up_pause_ton.Q 
		THEN
		GVL_IO.UP_pause_in := FALSE;
		GVL_IO.Step := 1320;
	END_IF
	
	1320:	//Cycle - MOtion DN Write parametrs	
	gvl_io.Position_sp_test := (GVL_IO.Position_DN_SP * 46603  *124) + (gvl_io.Position_PV_Diff);
	GVL_IO.Position_DN_SP_HL := (GVL_IO.Position_DN_SP) + 1;
	GVL_IO.Position_DN_SP_LL := (GVL_IO.Position_DN_SP) - 1;
	GVL_IO.Step := 1330;
	
	1330:	//Motor UP command - Wait finish motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_DN_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_DN_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_DN_SP_HL )
		THEN
		GVL_IO.Step := 1350;
	END_IF
	
	1350:	//Cycle -  open gripper 
	GVL_IO.Gripper_Open_cmd := TRUE;
	GVL_IO.Step := 1360;
	
	1360:	//Cycle - wait feedback gripper opened
	IF GVL_IO.ixGripper_Unlock
		AND NOT GVL_IO.Gripper_Open_cmd
		THEN 
		GVL_IO.Cycle_PV := GVL_IO.Cycle_PV + 1;
		GVL_IO.Step := 1370;
	END_IF
	
	1370:	//Cycle - Check cycle counters 
(*	
IF GVL_IO.Cycle_PV < GVL_IO.Cycle_SP
		THEN
		GVL_IO.Step := 260;
	ELSIF
		GVL_IO.Cycle_PV >= GVL_IO.Cycle_SP
		THEN
		GVL_IO.Step := 400;			
	END_IF
	*)
	
	GVL_IO.Step := 1400;	
	
	1400:	//Cycle - TO Home position 	
	gvl_io.Position_sp_test := (GVL_IO.Position_UP_SP * 46603  *124) + (gvl_io.Position_PV_Diff);
	GVL_IO.Position_UP_SP_HL := (GVL_IO.Position_UP_SP) + 1;
	GVL_IO.Position_UP_SP_LL := (GVL_IO.Position_UP_SP) - 1;
	GVL_IO.Step := 1410;
	
	1410:	//Cycle - TO Home position - Wait finish UP motion
	IF GVL_IO.Position_PV_HMI = GVL_IO.Position_UP_SP
		OR (GVL_IO.Position_PV_HMI >= gvl_io.Position_UP_SP_LL AND GVL_IO.Position_PV_HMI <= gvl_io.Position_UP_SP_HL )
		THEN
		GVL_IO.Step := 1430;
	END_IF
	
	1430:	//Cycle - TO Home position - close gripper
	GVL_IO.Gripper_Close_cmd := TRUE;
	GVL_IO.Step := 1440;
	
	1440:	//Cycle - TO Home position - wait gripper close
	IF NOT GVL_IO.Gripper_Close_cmd 
		AND GVL_IO.ixGripperLock_1
		AND GVL_IO.ixGripperLock_2
		THEN
		GVL_IO.Step := 0;
		GVL_IO.Start := FALSE;
		GVL_IO.test_slowCycle_OK := TRUE;
		
	END_IF
	
	
	
	
	
	

END_CASE]]></ST>
