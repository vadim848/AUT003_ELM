<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_RunLog" Id="{a4edbcce-a196-44ab-9e8c-14b79f4d344e}">
    <Declaration><![CDATA[// Run log module: what the HMI shows and enters. Format: report-tool/docs/log-format.md
{attribute 'qualified_only'}
VAR_GLOBAL
	SN			: STRING(32);	// part serial number, entered on Overview_ATP before START
	SN_valid	: BOOL;			// exactly three digits, 001..999; ATP START needs it
	State		: STRING(40);	// what the logger is doing now
	LastFile	: STRING(255);	// last finished run log
	LastError	: STRING(255);	// last problem; a run without a valid SN is not logged
	ErrorCount	: UDINT;
	{IF defined (Develop)}
	SelfTest	: BOOL;			// VM only: TRUE writes a scripted 10-sample run as <stamp>_999.log
	{END_IF}
END_VAR
VAR_GLOBAL CONSTANT
	PLC_VERSION	: STRING(20) := 'V2.0';	// bump by hand with every PLC program release; goes into each run log
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
