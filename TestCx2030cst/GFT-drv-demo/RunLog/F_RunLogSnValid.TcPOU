<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_RunLogSnValid" Id="{bbf8ec8b-a805-4011-b4ff-20b1cd818310}" SpecialFunc="None">
    <Declaration><![CDATA[// TRUE when sSN is exactly three digits, 001..999 ('18' is refused: one part, one SN, '018').
// The reader (elm-report) applies the same rule and rejects any other name.
FUNCTION F_RunLogSnValid : BOOL
VAR_INPUT
	sSN : STRING(32);
END_VAR
VAR
	i : INT;
	c : BYTE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_RunLogSnValid := LEN(sSN) = 3 AND sSN <> '000';
FOR i := 0 TO LEN(sSN) - 1 DO
	c := sSN[i];
	IF c < 16#30 OR c > 16#39 THEN		// 0-9 only
		F_RunLogSnValid := FALSE;
	END_IF
END_FOR
]]></ST>
    </Implementation>
    <LineIds Name="F_RunLogSnValid">
      <LineId Id="3" Count="9" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
